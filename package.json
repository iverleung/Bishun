{
  "name": "bishun",
  "version": "1.0.0",
  "description": "一个简洁的汉字笔顺动画展示网站，支持输入多个汉字并自动逐个播放笔顺动画。",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/run.js && node --test test/names.test.js test/resources.test.js",
    "test:preview": "node --test test/preview.test.js",
    "predev": "npm run resources:prepare",
    "prebuild": "npm run resources:prepare",
    "resources:prepare": "node tools/prepare-character-data.mjs",
    "resources:check": "node tools/prepare-character-data.mjs --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "hanzi-writer-data": "2.0.1",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "cnchar": "^3.2.6",
    "cnchar-order": "^3.2.6",
    "hanzi-writer": "^3.7.3"
  }
}
